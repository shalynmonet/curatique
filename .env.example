# Copy to .env.local and fill in. Never commit real secrets.

# Claude API (https://console.anthropic.com) — shopping agent, niche curation, PayPal-merchant checks
ANTHROPIC_API_KEY=
# Optional override (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Channel3 product API (https://channel3.ai) — search, product detail, similar, lookup
CHANNEL3_API_KEY=

# PayPal REST app credentials from https://developer.paypal.com (Sandbox → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox by default; live would be https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Store launch fee charged via PayPal Checkout (USD)
LAUNCH_FEE_USD=29.00

# Sandbox PERSONAL account email that receives payouts for the flagship houndstooth store
FLAGSHIP_PAYOUT_EMAIL=

# Where the JSON data store lives (mount a Render disk here for persistence)
DATA_DIR=.data
